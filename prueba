<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog - Página Principal</title>
    <style>
        /* =========================================
           VARIABLES Y CONFIGURACIÓN BASE
        ========================================= */
        :root {
            --color-primary: #4F46E5; /* Color acento (Índigo) */
            --color-primary-hover: #4338CA;
            --color-text-main: #1F2937; /* Gris muy oscuro */
            --color-text-muted: #6B7280; /* Gris medio */
            --color-bg-body: #F9FAFB;
            --color-bg-card: #FFFFFF;
            --color-border: #E5E7EB;
            
            --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            
            --radius-md: 0.5rem;
            --radius-lg: 1rem;
            
            --font-family: 'Inter', system-ui, -apple-system, sans-serif;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: var(--font-family);
            background-color: var(--color-bg-body);
            color: var(--color-text-main);
            line-height: 1.6;
        }

        a {
            text-decoration: none;
            color: inherit;
            transition: color 0.3s ease;
        }

        ul {
            list-style: none;
        }

        .container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        /* =========================================
           HEADER Y NAVEGACIÓN
        ========================================= */
        .site-header {
            background-color: var(--color-bg-card);
            box-shadow: var(--shadow-sm);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 4rem;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--color-primary);
        }

        .main-nav ul {
            display: flex;
            gap: 2rem;
        }

        .main-nav a {
            font-weight: 500;
            color: var(--color-text-muted);
        }

        .main-nav a:hover {
            color: var(--color-primary);
        }

        /* Ocultar menú en móviles por simplicidad visual sin JS */
        @media (max-width: 768px) {
            .main-nav ul {
                gap: 1rem;
                font-size: 0.9rem;
            }
        }

        /* =========================================
           HERO SECTION
        ========================================= */
        .hero {
            background: linear-gradient(135deg, #EEF2FF 0%, #E0E7FF 100%);
            padding: 5rem 1.5rem;
            text-align: center;
            border-bottom: 1px solid var(--color-border);
        }

        .hero h1 {
            font-size: 3rem;
            font-weight: 800;
            color: var(--color-text-main);
            margin-bottom: 1rem;
            letter-spacing: -0.025em;
        }

        .hero p {
            font-size: 1.25rem;
            color: var(--color-text-muted);
            max-width: 600px;
            margin: 0 auto;
        }

        /* =========================================
           ESTRUCTURA PRINCIPAL (LAYOUT)
        ========================================= */
        .layout-wrapper {
            display: flex;
            gap: 2rem;
            margin-top: 3rem;
            margin-bottom: 4rem;
        }

        .main-content {
            flex: 1; /* Toma todo el espacio disponible */
        }

        .sidebar {
            width: 320px;
            flex-shrink: 0;
        }

        /* Responsive: Sidebar pasa abajo en móviles y tablets pequeñas */
        @media (max-width: 992px) {
            .layout-wrapper {
                flex-direction: column;
            }
            .sidebar {
                width: 100%;
            }
        }

        /* =========================================
           GRID DE POSTS (MAIN CONTENT)
        ========================================= */
        .posts-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr); /* 3 columnas en desktop */
            gap: 2rem;
        }

        /* Responsive del Grid */
        @media (max-width: 1200px) {
            .posts-grid {
                grid-template-columns: repeat(2, 1fr); /* 2 columnas en pantallas medianas */
            }
        }

        @media (max-width: 768px) {
            .posts-grid {
                grid-template-columns: 1fr; /* 1 columna en móviles */
            }
        }

        /* Tarjeta de Post */
        .post-card {
            background-color: var(--color-bg-card);
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--color-border);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            display: flex;
            flex-direction: column;
        }

        .post-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-lg);
        }

        .post-image {
            width: 100%;
            aspect-ratio: 16 / 9;
            object-fit: cover;
            border-bottom: 1px solid var(--color-border);
        }

        .post-content {
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .post-category {
            font-size: 0.75rem;
            text-transform: uppercase;
            font-weight: 700;
            color: var(--color-primary);
            letter-spacing: 0.05em;
            margin-bottom: 0.5rem;
        }

        .post-title {
            font-size: 1.25rem;
            font-weight: 700;
            margin-bottom: 0.75rem;
            line-height: 1.4;
        }

        .post-excerpt {
            color: var(--color-text-muted);
            font-size: 0.95rem;
            margin-bottom: 1.5rem;
            flex-grow: 1; /* Empuja el botón hacia abajo */
        }

        .btn-read-more {
            display: inline-block;
            background-color: transparent;
            color: var(--color-primary);
            font-weight: 600;
            border: 2px solid var(--color-primary);
            padding: 0.5rem 1rem;
            border-radius: var(--radius-md);
            text-align: center;
            transition: background-color 0.3s ease, color 0.3s ease;
            width: fit-content;
        }

        .btn-read-more:hover {
            background-color: var(--color-primary);
            color: #FFFFFF;
        }

        /* =========================================
           SIDEBAR
        ========================================= */
        .sidebar-widget {
            background-color: var(--color-bg-card);
            padding: 1.5rem;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--color-border);
            margin-bottom: 2rem;
        }

        .sidebar-widget h3 {
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid var(--color-bg-body);
        }

        /* Buscador */
        .search-form {
            display: flex;
        }

        .search-input {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1px solid var(--color-border);
            border-radius: var(--radius-md) 0 0 var(--radius-md);
            outline: none;
            font-family: inherit;
        }

        .search-input:focus {
            border-color: var(--color-primary);
        }

        .search-btn {
            background-color: var(--color-primary);
            color: white;
            border: none;
            padding: 0 1rem;
            border-radius: 0 var(--radius-md) var(--radius-md) 0;
            cursor: pointer;
            font-weight: 600;
            transition: background-color 0.3s;
        }

        .search-btn:hover {
            background-color: var(--color-primary-hover);
        }

        /* Listas Sidebar (Categorías y Posts Recientes) */
        .widget-list li {
            margin-bottom: 0.75rem;
        }

        .widget-list li:last-child {
            margin-bottom: 0;
        }

        .widget-list a {
            color: var(--color-text-muted);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .widget-list a:hover {
            color: var(--color-primary);
            transform: translateX(4px);
        }

        .recent-post-link {
            display: block !important;
        }

        .recent-post-date {
            display: block;
            font-size: 0.8rem;
            color: #9CA3AF;
            margin-top: 0.25rem;
        }

        /* =========================================
           FOOTER
        ========================================= */
        .site-footer {
            background-color: var(--color-bg-card);
            border-top: 1px solid var(--color-border);
            padding: 3rem 0;
            margin-top: auto;
        }

        .footer-content {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 1.5rem;
        }

        .footer-links {
            display: flex;
            gap: 1.5rem;
        }

        .footer-links a {
            color: var(--color-text-muted);
            font-weight: 500;
        }

        .footer-links a:hover {
            color: var(--color-primary);
        }

        .footer-copy {
            color: var(--color-text-muted);
            font-size: 0.9rem;
        }
    </style>
</head>
<body>

